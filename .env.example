SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Customer-facing Shopify domain (the domain the theme + Cloudflare are
# configured for, e.g. the primary myshopify domain or a custom domain). Used
# for any storefront-facing links. Falls back to SHOPIFY_STORE_DOMAIN.
SHOPIFY_PUBLIC_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_your_storefront_access_token
SHOPIFY_API_VERSION=2025-07
# Shopify Admin API access token (server-only). Create a Custom App
# (Settings → Apps and sales channels → Develop apps → Create an app) with
# Admin API access scope `write_metaobjects`, install it, and paste the Admin
# API access token here. Required for the /contact form — it writes
# contact_message metaobjects to Shopify via the Admin API. NEVER expose this
# to the client (.env.local is gitignored).
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_your_admin_api_access_token
# Metaobject type handle that contact submissions are written to. Must match a
# metaobject definition created in the store (Settings → Custom data →
# Metaobjects) with fields: name (text), email (text), phone (text), body
# (multi-line text).
CONTACT_METAOBJECT_TYPE=contact_message

# Resend API key (server-only) for emailing contact-form messages to the store
# inbox. Create a key at https://resend.com/api-keys. NEVER expose to the client.
RESEND_API_KEY=re_your_resend_api_key
# Inbox that receives contact-form messages.
CONTACT_EMAIL_TO=hello@wearapeiron.com
# Verified sender address. Use an address on a domain verified in Resend
# (e.g. contact@wearapeiron.com). Defaults to Resend's shared test sender.
CONTACT_EMAIL_FROM=Apeiron Contact <contact@wearapeiron.com>

# Judge.me API token (server-only) for the product-page Reviews disclosure.
# Judge.me → Settings → Integrations → API → copy the PRIVATE API token (the
# public token is rejected by the reviews endpoint). NEVER expose to the
# client — reviews are fetched server-side only (lib/judge-me.ts).
JUDGE_ME_API_TOKEN=your_judge_me_api_token
# The shop domain your Judge.me account is bound to — the store's ORIGINAL
# myshopify domain (Judge.me keeps the binding from install time, even after a
# store rename). Defaults to SHOPIFY_STORE_DOMAIN when unset.
# JUDGE_ME_SHOP_DOMAIN=your-original-store.myshopify.com

# --- Contact email via SMTP (porkbun hosted mail) ---------------------------
# Preferred transport for the /contact form when using a porkbun mailbox.
# SMTP_USER is the full mailbox address; SMTP_PASS is the mailbox password
# (porkbun → Email → your mailbox → email client configuration).
# SMTP_HOST=smtp.porkbun.com
# SMTP_PORT=465
# SMTP_USER=hello@wearapeiron.com
# SMTP_PASS=your_mailbox_password

# Navidium shipping protection (server-only) — the lambda quote endpoint from
# the Navidium dashboard. Unset → the cart-drawer protection toggle is absent.
# NAVIDIUM_API_URL=https://your-navidium-lambda-url
# NAVIDIUM_SHOP_URL=your-original-store.myshopify.com
# NAVIDIUM_COUNTRY_NAME=United States
