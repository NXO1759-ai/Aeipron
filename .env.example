SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Customer-facing Shopify domain (the domain the theme + Cloudflare are
# configured for, e.g. the primary myshopify domain or a custom domain). Used
# for any storefront-facing links. Falls back to SHOPIFY_STORE_DOMAIN.
SHOPIFY_PUBLIC_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=shpat_your_storefront_access_token
SHOPIFY_API_VERSION=2025-07
# Shopify Admin API access token (server-only). Create a Custom App
# (Settings → Apps and sales channels → Develop apps → Create an app) with
# Admin API access scope `write_metaobjects`, install it, and paste the Admin
# API access token here. Required for the /contact form — it writes
# contact_message metaobjects to Shopify via the Admin API. NEVER expose this
# to the client (.env.local is gitignored).
SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_your_admin_api_access_token
# Metaobject type handle that contact submissions are written to. Must match a
# metaobject definition created in the store (Settings → Custom data →
# Metaobjects) with fields: name (text), email (text), phone (text), body
# (multi-line text).
CONTACT_METAOBJECT_TYPE=contact_message